PORT=8787
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,https://istek-zimmet.vercel.app
API_PUBLIC_URL=http://localhost:8787
# Cloudflare Tunnel / reverse proxy arkasında gerçek istemci IP'si için true.
TRUST_PROXY=false

# Yavaş/yarım HTTP isteklerinin soketleri gereksiz yere tutmasını sınırlar.
HTTP_REQUEST_TIMEOUT_MS=120000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_HEADERS_COUNT=100
HTTP_MAX_REQUESTS_PER_SOCKET=1000

# API geneli icin IP bazli kaba trafik siniri. Hassas aksiyonlarda ek sinirlar vardir.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_MAX_BUCKETS=50000

# Default instance için SQL_SERVER=localhost ve SQL_PORT=1433 kullanabilirsiniz.
# SQLEXPRESS gibi named instance için:
# SQL_SERVER=localhost\SQLEXPRESS
# SQL_PORT=
SQL_SERVER=localhost\SQLEXPRESS
SQL_PORT=
SQL_DATABASE=IstekZimmet
SQL_USER=zimmet_api
SQL_PASSWORD=change-me
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_CONNECTION_TIMEOUT_MS=15000
SQL_REQUEST_TIMEOUT_MS=60000
GOOGLE_CLIENT_ID=333289043957-05l0hq2r1aqafnclifl9dnvipkr99ba5.apps.googleusercontent.com
# Virgülle ayrılmış süper yönetici e-postaları. Bu yetki arayüzden verilemez.
SUPER_ADMIN_EMAILS=superadmin@istek.k12.tr
APP_SECRET=replace-with-long-random-secret
# T.C. kimlik numaralarını düz metin yerine HMAC özeti olarak saklamak için
# ayrı ve en az 32 karakterlik secret. SQL yedeğinden ayrı, güvenli saklayın.
PERSONNEL_ID_HMAC_SECRET=replace-with-a-separate-long-random-secret

# Tek-domain canli kurulumda oturum anahtarini JavaScript'ten gizler.
# Ayrik Vercel/API pilotunda gecis tamamlanana kadar false birakin.
SESSION_COOKIE_ENABLED=false
SESSION_COOKIE_NAME=istek_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=Lax
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_ALLOW_BODY_TOKEN_FALLBACK=false

AD_AGENT_SECRET=replace-with-ad-agent-secret
GLPI_SYNC_SECRET=replace-with-glpi-sync-secret
PERSONNEL_SYNC_SECRET=replace-with-personnel-sync-secret
SIGNATURE_AGENT_SECRET=replace-with-signature-agent-secret

# Agent istekleri timestamp + nonce + HMAC-SHA256 ile imzalanır.
# Sadece eski agentlara kısa süreli geçiş vermek gerekirse true yapın.
AGENT_AUTH_ALLOW_LEGACY=false
AGENT_AUTH_MAX_SKEW_SECONDS=300
AGENT_SECRET_ALLOW_DEV_FALLBACK=false

# OTP SMS gönderimi için opsiyonel Mobildev ayarları
MOBILDEV_SMS_API_URL=https://xmlapi.mobildev.com/
MOBILDEV_API_KEY=
MOBILDEV_API_SECRET=
MOBILDEV_ORIGINATOR=

# PDF üretimi ve kuyruk işleyici
PDF_CHROME_PATH=
PDF_CHROME_LAUNCH_TIMEOUT_MS=30000
PDF_RENDER_TIMEOUT_MS=45000
PDF_MAX_CONCURRENT_PAGES=2
QUEUE_WORKER_ENABLED=false
QUEUE_WORKER_INTERVAL_MS=30000
QUEUE_MAX_JOBS_PER_RUN=2
QUEUE_WORKER_CONCURRENCY=2
QUEUE_LEASE_SECONDS=1800
QUEUE_MAX_ATTEMPTS=5
GENERATED_PDF_DIR=
GENERATED_EXPORT_DIR=

# Nihai durumdaki gecici kuyruk kayitlarini periyodik temizler.
# BEKLIYOR/ISLENIYOR, HardwareHistory ve SystemLogs kayitlarina dokunmaz.
QUEUE_CLEANUP_ENABLED=true
QUEUE_CLEANUP_INTERVAL_MS=21600000
OPERATION_QUEUE_RETENTION_DAYS=30
AD_QUEUE_RETENTION_DAYS=30
SIGNATURE_QUEUE_RETENTION_DAYS=30
QUEUE_CLEANUP_BATCH_SIZE=500

# Tek domain canlı kullanımda React build'ini backend üzerinden servis et.
# Önce repo kökünde npm run build çalıştırın; varsayılan dist yolu ../dist.
SERVE_FRONTEND=false
FRONTEND_DIST_DIR=

# Node PDF -> Google Drive/Gmail Apps Script koprusu
GOOGLE_BRIDGE_URL=
GOOGLE_BRIDGE_SECRET=
GOOGLE_BRIDGE_UPLOAD_ACTION=uploadGeneratedPdf
